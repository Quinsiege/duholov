#!/bin/bash
# Секреты функции game (ЮKassa, сервисы входа) → /opt/duholov/functions.env, затем перезапуск функции.
# Запуск на сервере под root: duholov-secrets. Enter — оставить прежнее значение; «-» — очистить.
set -euo pipefail
F=/opt/duholov/functions.env
touch "$F"; chmod 600 "$F"
get() { grep -E "^$1=" "$F" | head -1 | cut -d= -f2- || true; }
ask() { # ask ИМЯ "подсказка" [secret]
  local cur new shown; cur=$(get "$1")
  if [ -n "${3:-}" ]; then shown=$([ -n "$cur" ] && echo "задан" || echo "пусто"); read -rsp "$2 [$shown]: " new; echo
  else read -rp "$2 [${cur:-пусто}]: " new; fi
  [ "$new" = "-" ] && new="" || { [ -z "$new" ] && new="$cur"; }
  sed -i "/^$1=/d" "$F"; printf '%s=%s\n' "$1" "$new" >> "$F"
}
[ -n "$(get ALLOWED_ORIGINS)" ] || echo "ALLOWED_ORIGINS=https://duholov.ru,https://quinsiege.github.io" >> "$F"
[ -n "$(get PAY_RETURN_URL)" ] || echo "PAY_RETURN_URL=https://duholov.ru/paid.html" >> "$F"
echo "— ЮKassa (кабинет → Интеграция → Ключи API)"
ask YOOKASSA_SHOP_ID "shopId"
ask YOOKASSA_SECRET_KEY "Секретный ключ" secret
ask PAY_RECEIPT "Чеки через ЮKassa (on — да, пусто — чек из «Мой налог»)"
echo "— Вход через сервисы (пусто — кнопки нет)"
ask GOOGLE_CLIENT_ID "Google OAuth Client ID"
ask YANDEX_CLIENT_ID "Яндекс ClientID"
ask VK_CLIENT_ID "VK ID приложения"
ask TELEGRAM_BOT_TOKEN "Токен бота Telegram" secret
echo "— Google Play (Казна в версии для Play): путь к JSON-ключу сервисного аккаунта на сервере (Enter — оставить, «-» — очистить)"
read -rp "Файл ключа [$([ -n "$(get GOOGLE_PLAY_SA)" ] && echo задан || echo пусто)]: " gpf
if [ "$gpf" = "-" ]; then sed -i "/^GOOGLE_PLAY_SA=/d" "$F"
elif [ -n "$gpf" ]; then
  gps=$(jq -ce 'select(.type == "service_account" and .client_email and .private_key)' "$gpf") || { echo "Это не ключ сервисного аккаунта Google"; exit 1; }
  sed -i "/^GOOGLE_PLAY_SA=/d" "$F"; printf 'GOOGLE_PLAY_SA=%s\n' "$gps" >> "$F"
  shred -u "$gpf" && echo "Ключ сохранён, файл $gpf удалён"
fi
cd /opt/duholov && docker compose up -d functions >/dev/null 2>&1
echo "Сохранено, функция перезапущена. Заданы: $(grep -E '=.+' "$F" | cut -d= -f1 | tr '\n' ' ')"
