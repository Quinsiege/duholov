#!/bin/bash
# Задать пароль входа учётной записи (модератор админки или игрок «по почте»). Запуск на сервере под root:
#   duholov-set-password
# Спрашивает почту и пароль; пароль не попадает ни в историю команд, ни в список процессов.
set -euo pipefail
read -rp "Почта учётной записи: " EMAIL
read -rsp "Новый пароль (от 10 символов): " PW; echo
[ ${#PW} -ge 10 ] || { echo "Слишком короткий пароль"; exit 1; }
q() { printf "%s" "$1" | sed "s/'/''/g"; }
N=$(printf "update auth.users set encrypted_password = extensions.crypt('%s', extensions.gen_salt('bf')), updated_at = now() where lower(email) = lower('%s') returning id;\n" "$(q "$PW")" "$(q "$EMAIL")" \
  | docker exec -i supabase-db psql -U supabase_admin -d postgres -tAq | grep -c . || true)
[ "$N" = "1" ] && echo "Пароль задан" || echo "Учётная запись с такой почтой не найдена"
